{
  "name": "mizfit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "env:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/validate-env.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:all": "npm run lint && npm run typecheck && npm run check:secrets && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.3",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.24.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.3"
  }
}
