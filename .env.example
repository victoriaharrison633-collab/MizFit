# MizFit — environment variables
#
# The buckets below are copied from SPEC.md § 11 and must stay in sync with the
# schemas in src/env.ts. Do not add a variable that SPEC.md § 11 does not list.
# Placeholder values only — never commit a real key (CLAUDE.md Rule 11).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app will not boot without these
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE — the feature that depends on the variable degrades without it
# ─────────────────────────────────────────────────────────────────────────────
# Meal-plan generation. Never needed in development: NODE_ENV !== 'production'
# or AI_MOCK=1 returns fixture data and opens no network connection (Rule 13).
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
AI_MODEL=claude-sonnet-5

# Rate limiting. Missing in development = fail open with a loud warning;
# missing in production = fail closed (Rule 10).
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# Transactional email — password reset and email verification.
RESEND_API_KEY=replace-with-your-resend-api-key

# Optional Prompt 3b (nutrition enrichment) only.
USDA_FDC_API_KEY=replace-with-your-usda-fdc-api-key

# ─────────────────────────────────────────────────────────────────────────────
# NON-SECRET, REQUIRED HEADER
# ─────────────────────────────────────────────────────────────────────────────
# Identifying User-Agent that Open Food Facts' usage guidelines require on every
# request. Not a credential. Optional Prompt 3b only.
OPEN_FOOD_FACTS_USER_AGENT=MizFit/0.1 (contact@example.com)

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
# Set to 1 to force the AI mock even when NODE_ENV=production.
AI_MOCK=
